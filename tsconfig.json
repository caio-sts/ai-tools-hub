{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["astro/client"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "astro.config.mjs",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".astro"]
}
