---
import Layout from '../../components/Layout.astro';
import { loadMeta } from '../../lib/data.ts';
import { loadTaxonomy } from '../../lib/taxonomy.ts';
import { evaluateStaleness, parseMeta } from '../../lib/staleness.ts';
import { t } from '../../lib/i18n/index.ts';
import type { Lang } from '../../types.ts';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const lang: Lang = Astro.params.lang === 'pt' ? 'pt' : 'en';

/**
 * Spec §5. The weights are data, and the formula string is derived from them, so the line this
 * page publishes and the rows below it cannot disagree — they are one source rendered twice.
 * tests/build/methodology.test.ts compares the result against the spec document itself.
 */
const TERMS = [
  { term: 'adoption', label: 'skill.adoption', rule: 'methodology.score.adoption', weight: 25 },
  { term: 'maintenance', label: 'skill.maintenance', rule: 'methodology.score.maintenance', weight: 30 },
  { term: 'provenance', label: 'skill.provenanceScore', rule: 'methodology.score.provenance', weight: 25 },
  { term: 'completeness', label: 'skill.completeness', rule: 'methodology.score.completeness', weight: 20 },
] as const;

/** English term names, because the formula is quoted verbatim from the spec in both locales. */
const FORMULA_NAMES: Record<string, string> = {
  adoption: 'Adoption', maintenance: 'Maintenance', provenance: 'Provenance', completeness: 'Completeness',
};
const FORMULA = `SCORE = ${TERMS.map((t) => `${FORMULA_NAMES[t.term]} ${t.weight}`).join(' + ')}`;
const MAX_WEIGHT = Math.max(...TERMS.map((t) => t.weight));

const taxonomy = loadTaxonomy();
const report = evaluateStaleness(parseMeta(loadMeta()), new Date());
const aliasPairs = Object.entries(taxonomy.aliases);
---

<Layout lang={lang} title={t('methodology.title', lang)} description={t('methodology.intro', lang)}>
  <article class="methodology">
    <h1>{t('methodology.title', lang)}</h1>
    <p class="methodology__intro">{t('methodology.intro', lang)}</p>

    <section aria-labelledby="score">
      <h2 id="score">{t('methodology.score.heading', lang)}</h2>
      <p class="methodology__label">{t('methodology.score.formulaLabel', lang)}</p>
      <p class="methodology__formula"><code>{FORMULA}</code></p>

      {/* The same model the card's panel draws, drawn the same way: a reader who opened a
          breakdown recognises this on sight. */}
      <ul class="terms">
        {TERMS.map((entry) => (
          <li class="term" data-term={entry.term}>
            <span class="term__name">{t(entry.label, lang)}</span>
            <span class="term__track" aria-hidden="true">
              <span class="term__fill" style={`width:${Math.round((entry.weight / MAX_WEIGHT) * 100)}%`}></span>
            </span>
            <span class="term__weight">{entry.weight}</span>
            <p class="term__rule">{t(entry.rule, lang)}</p>
          </li>
        ))}
      </ul>

      <p>{t('methodology.score.balance', lang)}</p>
      <p class="methodology__emphasis">{t('methodology.score.noSafety', lang)}</p>
      <p>{t('methodology.score.noOverride', lang)}</p>
    </section>

    <section aria-labelledby="inclusion">
      <h2 id="inclusion">{t('methodology.inclusion.heading', lang)}</h2>
      <p>{t('methodology.inclusion.body', lang)}</p>
      <ol>
        <li>{t('methodology.inclusion.r1', lang)}</li>
        <li>{t('methodology.inclusion.r2', lang)}</li>
        <li>{t('methodology.inclusion.r3', lang)}</li>
        <li>{t('methodology.inclusion.r4', lang)}</li>
        <li>{t('methodology.inclusion.r5', lang)}</li>
        <li>{t('methodology.inclusion.r6', lang)}</li>
      </ol>
    </section>

    <section aria-labelledby="safety">
      <h2 id="safety">{t('methodology.safety.heading', lang)}</h2>
      <p>{t('methodology.safety.body', lang)}</p>
      <ul>
        <li>{t('methodology.safety.executes', lang)}</li>
        <li>{t('methodology.safety.network', lang)}</li>
        <li>{t('methodology.safety.env', lang)}</li>
      </ul>
      <p class="methodology__emphasis">{t('methodology.safety.noGreen', lang)}</p>
    </section>

    <section aria-labelledby="counting">
      <h2 id="counting">{t('methodology.counting.heading', lang)}</h2>
      <ul>
        <li>{t('methodology.counting.symlinks', lang)}</li>
        <li>{t('methodology.counting.dedupe', lang)}</li>
        <li>{t('methodology.counting.excluded', lang)}</li>
        <li>{t('methodology.counting.dated', lang)}</li>
      </ul>
    </section>

    <section aria-labelledby="taxonomy">
      <h2 id="taxonomy">{t('methodology.taxonomy.heading', lang)}</h2>
      <p>{t('methodology.taxonomy.namingRule', lang)}</p>

      <h3>{t('methodology.taxonomy.protectedLabel', lang)}</h3>
      <ul class="methodology__terms" data-protected-terms>
        {taxonomy.protected.map((term) => <li><code>{term}</code></li>)}
      </ul>
      <p>{t('methodology.taxonomy.protectedNote', lang)}</p>

      <h3>{t('methodology.taxonomy.aliasesLabel', lang)}</h3>
      <ul class="methodology__terms" data-aliases>
        {aliasPairs.map(([alias, target]) => (
          <li><code>{alias}</code> → <code>{target}</code></li>
        ))}
      </ul>
      <p>{t('methodology.taxonomy.aliasesNote', lang)}</p>

      <h3>{t('methodology.taxonomy.minimumMassLabel', lang)}</h3>
      <p data-minimum-mass={String(taxonomy.minimumMass)}>
        {taxonomy.minimumMass} — {t('methodology.taxonomy.minimumMassNote', lang)}
      </p>
    </section>

    <section aria-labelledby="provenance">
      <h2 id="provenance">{t('methodology.provenance.heading', lang)}</h2>
      <p><code>owner/repo@commit:path</code> — {t('methodology.provenance.id', lang)}</p>

      <h3>{t('methodology.provenance.sourcesLabel', lang)}</h3>
      <dl class="methodology__facts">
        <dt>{t('methodology.provenance.skillsLabel', lang)}</dt>
        <dd data-skill-count={String(report.skillCount)}>{report.skillCount}</dd>
        <dt>{t('methodology.provenance.sourceCountLabel', lang)}</dt>
        <dd data-source-count={String(report.sourceCount)}>{report.sourceCount}</dd>
      </dl>

      <h3>{t('methodology.provenance.freshnessLabel', lang)}</h3>
      <dl class="methodology__facts">
        <dt>{t('methodology.provenance.crawledLabel', lang)}</dt>
        <dd data-crawled-at={report.crawl.iso ?? ''}>
          {report.crawl.iso ?? t('methodology.provenance.never', lang)}
        </dd>
        <dt>{t('methodology.provenance.classifiedLabel', lang)}</dt>
        <dd data-classified-at={report.classification.iso ?? ''}>
          {report.classification.iso ?? t('methodology.provenance.never', lang)}
        </dd>
      </dl>
      <p>{t('methodology.provenance.freshnessNote', lang)}</p>
    </section>
  </article>
</Layout>

<style>
  /* This page is the auditability claim, and it was the one page that never got a design pass: no
     vertical rhythm, four lists rendering as undifferentiated prose, and the single line it exists
     to publish — the formula — cut off behind a horizontal scrollbar.

     Left-aligned at the site's 1rem gutter, not centred: every other page starts there, and a
     centred column here would read as a different site. The measure stays at 68ch, which is what
     prose needs. */
  .methodology {
    max-width: 68ch;
    padding: 2.5rem 1rem 5rem;
    line-height: 1.65;
  }
  .methodology h1 { margin: 0 0 0.5rem; }
  .methodology__intro {
    margin: 0 0 1rem;
    font-size: var(--text-lg);
    color: var(--color-n-11);
    max-width: 54ch;
  }

  .methodology section { margin-top: 3rem; }
  .methodology h2 {
    margin: 0 0 1.25rem;
    padding-top: 0.875rem;
    border-top: 2px solid var(--color-n-12);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    scroll-margin-top: var(--header-h, 3.5rem);
  }
  .methodology h3 {
    margin: 2rem 0 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-n-11);
  }
  .methodology p { margin: 0 0 0.875rem; }

  .methodology__label {
    margin: 0 0 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-n-11);
  }
  /* Wraps rather than scrolls: a reader who cannot see the whole formula cannot check it. */
  .methodology__formula {
    margin: 0 0 1.75rem;
    border: 1px solid var(--color-n-7);
    background: var(--color-n-2);
    padding: 0.875rem 1rem;
  }
  .methodology__formula code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  /* The card's score panel, restated. Same order, same proportion, same tabular weight. */
  .terms { list-style: none; margin: 0 0 1.5rem; padding: 0; }
  .term {
    display: grid;
    grid-template-columns: minmax(7rem, max-content) minmax(3rem, 1fr) max-content;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-n-6);
  }
  .term:last-child { border-bottom: 1px solid var(--color-n-6); }
  .term__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .term__track { display: block; height: 6px; background: var(--color-n-3); }
  .term__fill { display: block; height: 100%; background: var(--color-a-9); }
  .term__weight {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .term__rule {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-n-11);
  }

  /* Rules and counting are enumerated claims, so they are numbered and separated rather than run
     together as prose — every one of these lists rendered as an undifferentiated paragraph. */
  .methodology ol,
  .methodology section > ul:not(.terms):not(.methodology__terms) {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }
  .methodology ol { list-style: decimal; }
  .methodology section > ul:not(.terms):not(.methodology__terms) { list-style: square; }
  .methodology li { margin-bottom: 0.5rem; }
  .methodology li::marker { color: var(--color-n-9); font-family: var(--font-mono); }

  .methodology__emphasis {
    border-inline-start: 3px solid var(--color-a-9);
    background: var(--color-a-2);
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
  }

  .methodology__terms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .methodology__terms li {
    margin: 0;
    border: 1px solid var(--color-n-6);
    background: var(--color-n-2);
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .methodology__facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1.25rem;
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .methodology__facts dt { color: var(--color-n-11); }
  .methodology__facts dd { margin: 0; font-variant-numeric: tabular-nums; }

  @media (max-width: 599px) {
    .methodology { padding: 1.5rem 1rem 3rem; }
    /* Placed explicitly: letting the track span 1/-1 and auto-placing the rest pushed the weight
       onto its own row and collapsed the second column to zero. Name and weight share row one,
       the bar gets the full width beneath them. */
    .term { grid-template-columns: 1fr max-content; }
    .term__name { grid-area: 1 / 1 / 2 / 2; }
    .term__weight { grid-area: 1 / 2 / 2 / 3; }
    .term__track { grid-area: 2 / 1 / 3 / -1; }
    .term__rule { grid-area: 3 / 1 / 4 / -1; }
  }
</style>
