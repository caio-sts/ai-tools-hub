---
import type { Lang } from '../../types.ts';
import Layout from '../../components/Layout.astro';
import TaxonomyNode from '../../components/TaxonomyNode.astro';
import { loadMeta, loadSkills } from '../../lib/data.ts';
import { STALE_DAYS, compactNumber, relativeDays } from '../../lib/format.ts';
import { DEFAULT_LANG, LANGS, isLang, t } from '../../lib/i18n/index.ts';
import { withBase } from '../../lib/link.ts';
import { countBySlug, countDomain, loadTaxonomy, nodeName } from '../../lib/taxonomy.ts';

export function getStaticPaths() {
  return LANGS.map((value) => ({ params: { lang: value } }));
}

const lang: Lang = isLang(Astro.params.lang) ? Astro.params.lang : DEFAULT_LANG;
const meta = loadMeta();
const taxonomy = loadTaxonomy();
const skills = loadSkills();
const counts = countBySlug(skills);
const security = taxonomy.domains.find((domain) => domain.slug === 'security');
if (security === undefined) {
  throw new Error('data/taxonomy.json has no "security" domain: the home page cannot expand it');
}
const securityChildren = security.children ?? [];
const otherDomains = taxonomy.domains.filter((domain) => domain.slug !== 'security');

// A6 always writes an ISO crawledAt; an unparsable one reads as 0 days rather than NaN.
const crawledAtMs = Date.parse(meta.crawledAt);
const crawlDays = Number.isNaN(crawledAtMs)
  ? 0
  : Math.max(0, Math.floor((Date.now() - crawledAtMs) / 86_400_000));

/* Spec §9.2: past the one shared threshold the cell renders in hazard orange and says so in
   words. STALE_DAYS lives in src/lib/format.ts (B1) and is the only definition of it in the
   project; B5's rescue banner reads the same constant. */
const stale = crawlDays > STALE_DAYS;

const stats = [
  { key: 'skills', label: t('stats.skills', lang), value: compactNumber(meta.skillCount, lang) },
  { key: 'sources', label: t('stats.sources', lang), value: compactNumber(meta.sourceCount, lang) },
  {
    key: 'domains',
    label: t('stats.domains', lang),
    value: compactNumber(taxonomy.domains.length, lang),
  },
];

/* taxonomy.aliases maps abbreviation -> slug, and the nodes need the inverse. Its values are the
   bare leaf (`code-application`) while a node carries the qualified slug
   (`security/code-application`), so the index is keyed by leaf and read the same way. This is the
   field's first consumer — nothing in src/lib touches it. */
const aliasesByLeaf = new Map<string, string[]>();
for (const [alias, target] of Object.entries(taxonomy.aliases)) {
  const leaf = target.split('/').pop() ?? target;
  aliasesByLeaf.set(leaf, [...(aliasesByLeaf.get(leaf) ?? []), alias]);
}
const aliasesFor = (slug: string): string[] => aliasesByLeaf.get(slug.split('/').pop() ?? slug) ?? [];

const catalogHref = withBase(`/${lang}/catalog/`);
const title = `${t('site.name', lang)} — ${t('site.thesis', lang)}`;
---

<Layout lang={lang} title={title} description={t('home.description', lang)}>
  <section class="intro">
    <h1 class="intro__thesis">{t('site.thesis', lang)}</h1>
    <p class="intro__support">{t('site.support', lang)}</p>
    <p class="intro__actions">
      <a class="intro__catalog" href={catalogHref}>{t('nav.catalog', lang)}</a>
    </p>
  </section>

  <dl class="stats">
    {
      stats.map((stat) => (
        <div class="stat">
          <dt class="stat__label">{stat.label}</dt>
          <dd class="stat__value" data-stat={stat.key}>{stat.value}</dd>
        </div>
      ))
    }
    <div class="stat">
      <dt class="stat__label">{t('stats.lastRefresh', lang)}</dt>
      <dd
        class:list={['stat__value', stale && 'meta__updated--stale']}
        data-stat="refresh"
        data-days={crawlDays}
        data-stale={stale ? 'true' : 'false'}
      >
        {relativeDays(crawlDays, lang)}
        {stale && <span class="stat__flag">{t('home.staleNote', lang)}</span>}
      </dd>
    </div>
  </dl>

  <form class="group-filter" data-group-filter role="search" method="get" action={catalogHref}>
    <label class="group-filter__label" for="group-q">{t('home.filterLabel', lang)}</label>
    <div class="group-filter__row">
      <input
        class="group-filter__input"
        id="group-q"
        data-group-input
        type="search"
        name="q"
        autocomplete="off"
        placeholder={t('home.filterPlaceholder', lang)}
      />
      <button
        class="group-filter__clear"
        type="button"
        data-group-clear
        aria-label={t('home.filterClear', lang)}
      >&#215;</button>
    </div>
    <p
      class="group-filter__status"
      data-group-status
      data-count-word={t('home.filterCount', lang)}
      data-empty-text={t('home.filterEmpty', lang)}
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </form>

  <section id="taxonomy" class="domain" aria-labelledby="security-heading">
    <h2 class="domain__title" id="security-heading">{nodeName('security', lang)}</h2>
    <p class="domain__lead">{t('home.securityLead', lang)}</p>
    <ul class="grid" data-grid="security">
      {
        securityChildren.map((child) => (
          <TaxonomyNode
            slug={child.slug}
            count={counts.get(child.slug) ?? 0}
            minimumMass={taxonomy.minimumMass}
            lang={lang}
            aliases={aliasesFor(child.slug)}
          />
        ))
      }
    </ul>
  </section>

  <section id="other-domains" class="domain" aria-labelledby="other-heading">
    <h2 class="domain__title" id="other-heading">{t('home.otherHeading', lang)}</h2>
    <p class="domain__lead">{t('home.otherLead', lang)}</p>
    <ul class="grid" data-grid="domains">
      {
        otherDomains.map((domain) => (
          <TaxonomyNode
            slug={domain.slug}
            count={countDomain(skills, domain.slug)}
            minimumMass={taxonomy.minimumMass}
            lang={lang}
            filterKey="domain"
            aliases={aliasesFor(domain.slug)}
          />
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  /* The taxonomy is a closed set of a few dozen nodes already in the DOM, so this filters what is
     rendered rather than reaching for Pagefind. No debounce: matching 40 strings is free, and a
     delay on a list this small only makes the page feel broken. */
  const form = document.querySelector<HTMLFormElement>('[data-group-filter]');
  const input = document.querySelector<HTMLInputElement>('[data-group-input]');
  const status = document.querySelector<HTMLElement>('[data-group-status]');

  if (form && input && status) {
    const nodes = [...document.querySelectorAll<HTMLElement>('.node[data-search]')];
    const sections = [...document.querySelectorAll<HTMLElement>('.domain')];
    const shownWord = status.dataset.countWord ?? '';
    const emptyText = status.dataset.emptyText ?? '';

    function fold(value: string): string {
      return value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();
    }

    function apply(): void {
      const query = fold(input!.value);
      let shown = 0;
      for (const node of nodes) {
        const hit = query === '' || (node.dataset.search ?? '').includes(query);
        node.hidden = !hit;
        if (hit) shown += 1;
      }
      /* A heading over an empty grid is worse than no section at all. */
      for (const section of sections) {
        const any = [...section.querySelectorAll<HTMLElement>('.node')].some((n) => !n.hidden);
        section.hidden = !any;
      }
      status.textContent = query === ''
        ? ''
        : shown === 0
          ? emptyText
          : `${shownWord}: ${shown}`;
    }

    input.addEventListener('input', apply);
    /* Enter must not navigate to the catalog: with JavaScript on, this form filters in place. */
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
    });
    document.querySelector('[data-group-clear]')?.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
  }
</script>

<style>
  /* Every surface below the header needs the same gutter; the home had none, so its content sat
     flush against the viewport edge. */
  .intro,
  .stats,
  .domain,
  .group-filter {
    margin-inline: 1rem;
  }
  .intro {
    max-width: 62ch;
    padding-top: 2rem;
  }
  .intro__thesis {
    margin: 0 0 0.5rem;
    font-size: var(--text-3xl);
    line-height: var(--text-3xl--line-height);
  }
  .intro__support {
    margin: 0;
    color: var(--muted-foreground);
  }
  .intro__actions {
    margin: 1rem 0 0;
  }
  .intro__catalog {
    color: var(--color-a-11);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 2rem 0 3rem;
    padding: 0;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .stat {
    flex: 1 1 9rem;
    padding: 0.75rem 1rem;
    background: var(--card);
  }
  .stat__label {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .stat__value {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
  }
  /* Hazard orange means one thing (§9.2). `.meta__updated--stale` is one of the three
     selectors allowed to read the token; the site-wide allowlist lives in
     tests/build/hazard-token.test.ts (B4.13). No fallback: a fallback would hide this
     usage from that guard. */
  .meta__updated--stale {
    color: var(--color-hazard);
  }
  .stat__flag {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  .domain {
    margin-block: 2.5rem;
    /* WCAG 2.2 2.4.11: a sticky header must not cover the node a link jumps to. */
    scroll-margin-top: 5rem;
  }
  .domain__title {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .domain__lead {
    margin: 0 0 1rem;
    max-width: 62ch;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .group-filter {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin-block: 0 2.5rem;
  }
  .group-filter__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .group-filter__row {
    display: flex;
    max-width: 32rem;
    border: 1px solid var(--input);
    background: var(--color-n-1);
    transition: border-color var(--motion-state) var(--motion-ease);
  }
  .group-filter__row:hover { border-color: var(--color-n-8); }
  .group-filter__row:focus-within {
    border-color: var(--ring);
    outline: 2px solid var(--ring);
    outline-offset: -1px;
  }
  .group-filter__input {
    flex: 1 1 auto;
    min-height: 40px;
    min-width: 24px;
    padding: 0 0.875rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .group-filter__input:focus-visible { outline: 0; }
  .group-filter__input::placeholder { color: var(--color-n-9); }
  .group-filter__input::-webkit-search-cancel-button { display: none; }
  .group-filter__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    min-width: 40px;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    font: inherit;
    font-size: var(--text-lg);
    line-height: 1;
  }
  .group-filter__clear:hover { color: var(--foreground); background: var(--color-n-3); }
  .group-filter__status {
    margin: 0;
    min-height: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  /* With JavaScript off the filter cannot work, and a dead input is worse than none. */
  .node[hidden] { display: none; }
</style>

<noscript><style>[data-group-filter]{display:none}</style></noscript>
