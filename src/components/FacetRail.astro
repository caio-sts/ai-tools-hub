---
import type { Lang } from '../types.ts';
import type { FacetGroup } from '../lib/facets.ts';
import { t } from '../lib/i18n/index.ts';

interface Props {
  lang: Lang;
  groups: FacetGroup[];
}

const { lang, groups } = Astro.props;
---
<details class="facet-disclosure" data-facet-disclosure open>
  <summary class="facet-summary" data-facet-summary>
    <span class="facet-summary-label">{t('catalog.railTitle', lang)}</span>
    <span class="facet-summary-count" data-facet-active-count hidden></span>
  </summary>
<aside class="facet-rail" data-facet-rail aria-label={t('catalog.railTitle', lang)}>
  {groups.map((group) => (
    <section class="facet-group" data-facet-group={group.key}>
      <h2 class="facet-group-title">{group.label}</h2>
      <p class="facet-group-hint">{group.hint}</p>
      <ul class="facet-list">
        {group.options.map((option, i) => (
          <>
            {option.group && option.group !== group.options[i - 1]?.group && (
              <li class="facet-subhead" aria-hidden="true">{option.group}</li>
            )}
            <li>
              <label class="facet-row" data-facet-key={group.key} data-facet-value={option.value}>
                <input class="facet-check" data-facet-check type="checkbox" name={group.key} value={option.value} />
                <span class="facet-text">{option.label}</span>
                <span class="facet-count" data-facet-count>{option.count}</span>
              </label>
            </li>
          </>
        ))}
      </ul>
    </section>
  ))}
</aside>
</details>
<style is:global>
  /* Sticks alongside the grid: with 60 results the rail scrolls out of reach immediately, and a
     filter you have to scroll back up to reach is a filter nobody uses. */
  .facet-rail {
    position: sticky;
    top: calc(var(--header-h, 3.5rem));
    align-self: start;
    max-height: calc(100vh - var(--header-h, 3.5rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    padding: 0 0 2rem;
    border-right: 1px solid var(--border);
  }
  /* The disclosure is a wrapper only: on a wide viewport the summary is gone and the rail is the
     sidebar it has always been. It carries `open` in the markup, so the filters are reachable with
     no JavaScript at all, at any width. */
  .facet-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .facet-summary:focus-visible { outline: 2px solid var(--ring); outline-offset: -2px; }
  .facet-summary-count {
    font-variant-numeric: tabular-nums;
    color: var(--color-a-11);
  }
  .facet-summary-count[hidden] { display: none; }

  @media (min-width: 900px) {
    .facet-summary { display: none; }
  }

  /* Below the sidebar breakpoint the rail is stacked ABOVE the results, so sticking it and capping
     its height turned it into a nested scroller that filled the whole screen and pushed the first
     card 1247px down. Stacked, it must simply flow. */
  @media (max-width: 899px) {
    .facet-rail {
      position: static;
      max-height: none;
      overflow-y: visible;
      border-right-width: 0;
      border-bottom: 1px solid var(--border);
    }
  }

  .facet-group { padding: 1.125rem 1rem; border-top: 1px solid var(--border); }
  .facet-group:first-child { border-top-width: 0; }
  .facet-group-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .facet-group-hint {
    margin: 0.25rem 0 0.625rem;
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--muted-foreground);
  }
  .facet-list { list-style: none; margin: 0; padding: 0; }
  .facet-subhead {
    margin: 0.875rem 0 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-n-9);
  }
  .facet-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    min-width: 24px;
    /* Bleeds into the rail padding so the hover band spans the full column rather than
       floating inside it. */
    margin: 0 -1rem;
    padding: 0.25rem 1rem;
    cursor: pointer;
    transition: background-color var(--motion-state) var(--motion-ease);
    scroll-margin-top: var(--header-h, 3.5rem);
  }
  .facet-row:hover { background: var(--color-n-3); }
  .facet-row:focus-within { outline: 2px solid var(--ring); outline-offset: -2px; }
  .facet-row:has(.facet-check:checked) { background: var(--color-a-3); }

  /* Square, 1px, no radius — the native control is the one widget that would ignore the whole
     design language. The box stays a full 24x24: WCAG 2.5.8 sizes the control itself, and
     painting a smaller square would have traded a real guarantee for a few pixels of polish. */
  .facet-check {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    height: 24px;
    width: 24px;
    min-height: 24px;
    min-width: 24px;
    margin: 0;
    border: 1px solid var(--input);
    background: var(--color-n-1);
    cursor: pointer;
    transition: background-color var(--motion-state) var(--motion-ease),
      border-color var(--motion-state) var(--motion-ease);
  }
  .facet-check:hover { border-color: var(--color-n-9); }
  .facet-check:checked {
    border-color: var(--color-a-9);
    background: var(--color-a-9);
  }
  /* Drawn, not a glyph: a checkmark character would inherit the page font and shift. */
  .facet-check:checked::after {
    content: '';
    display: block;
    height: 10px;
    width: 5px;
    margin: 4px 0 0 8px;
    border: 2px solid var(--color-n-1);
    border-top-width: 0;
    border-left-width: 0;
    transform: rotate(43deg);
  }
  .facet-check:focus-visible { outline: 2px solid var(--ring); outline-offset: 1px; }

  .facet-text { flex: 1 1 auto; font-size: var(--text-sm); line-height: 1.3; }
  .facet-count {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
